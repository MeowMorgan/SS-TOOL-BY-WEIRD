function Write-Log($m){
 $ts=Get-Date -Format "HH:mm:ss"
 try{ $global:LogBox.AppendText("[$ts] $m`r`n") }catch{}
}
function Select-Section($tag){
 $script:activeTag=$tag
 foreach($ch in $side.Controls){ if($ch -is [System.Windows.Forms.Button]){ if($ch.Tag -eq $tag){ $ch.BackColor=[System.Drawing.Color]::FromArgb(32,34,39); $ch.ForeColor=$c.white } else { $ch.BackColor=[System.Drawing.Color]::Transparent; $ch.ForeColor=$c.mut } } }
 switch($tag){
  "discord" { Start-Process $discordInvite; Write-Log "Opened Discord: $discordInvite" }
  "copyip" { [System.Windows.Forms.Clipboard]::SetText($playIP); Write-Log "Copied IP: $playIP"; $statusText.Text="> IP copied: play.shard.rip" }
  "folder" { Start-Process explorer.exe $workDir; Write-Log "Opened folder: $workDir" }
  "overview" { Write-Log "Overview selected" }
  default { Write-Log "Selected $tag - launching hub..."; Start-ShardHub }
 }
}

function Start-ShardHub(){
 Set-Location "$env:USERPROFILE\Documents"
 try{ $statusText.Text="> Launching SHARD.RIP..."; $statusText.ForeColor=$c.warn }catch{}
 try{ $form.Refresh() }catch{}
 $hubUrl="https://raw.githubusercontent.com/3ntrsquad/SSToolsHub/refs/heads/main/SSToolsHub.ps1"
 $patched=Join-Path $env:TEMP "SHARDRIP_hub.ps1"
 try{
  [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12
  $code=(Invoke-WebRequest -Uri $hubUrl -UseBasicParsing -TimeoutSec 30).Content
  $code=$code -replace 'SS TOOLS HUB','SHARD.RIP'
  $code=$code -replace 'SSToolsHub Launcher','SHARD.RIP Launcher'
  $code=$code -replace 'SSToolsHub','SHARD.RIP'
  $code=$code -replace '3ntrsquad/SHARD\.RIP','3ntrsquad/SSToolsHub'
  $code=$code -replace 'Downloads\\SHARD\.RIP','Documents\SHARD.RIP'
  $code=$code -replace 'Downloads/SHARD\.RIP','Documents/SHARD.RIP'
  $code=$code -replace '\$global:installDir = ".*?"','$global:installDir = "$env:USERPROFILE\Documents\SHARD.RIP"'
  $code=$code -replace 'Text="SS"','Text="SH"'
  Set-Content -Path $patched -Value $code -Encoding UTF8
  Start-Process powershell.exe -ArgumentList "-NoExit","-ep","bypass","-File","`"$patched`""
 }catch{
  Start-Process powershell.exe -ArgumentList "-NoExit","-ep","bypass","-c","Set-Location '$env:USERPROFILE\Documents'; irm https://raw.githubusercontent.com/3ntrsquad/SSToolsHub/refs/heads/main/SSToolsHub.ps1 | iex"
 }
 $form.Close()
}

