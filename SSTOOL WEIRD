function New-OceanCard($x,$y,$w,$h,$style="ocean"){
 $p = New-Object System.Windows.Forms.Panel
 $p.Size=New-Object System.Drawing.Size($w,$h); $p.Location=New-Object System.Drawing.Point($x,$y); $p.BackColor=[System.Drawing.Color]::Transparent
 $p.Paint.Add({
  $g=$_.Graphics; $g.SmoothingMode=[System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
  $ww=$p.Width; $hh=$p.Height
  $rr=New-Object System.Drawing.Drawing2D.GraphicsPath; $r=16
  $rr.AddArc(0,0,$r,$r,180,90); $rr.AddArc($ww-$r,0,$r,$r,270,90); $rr.AddArc($ww-$r,$hh-$r,$r,$r,0,90); $rr.AddArc(0,$hh-$r,$r,$r,90,90); $rr.CloseFigure()
  if($style -eq "danger"){
   # header: linear-gradient(108deg, #0a0e17 28%, #481a22)
   $cardRect=New-Object System.Drawing.Rectangle(0,0,$ww,$hh)
   $br=New-Object System.Drawing.Drawing2D.LinearGradientBrush($cardRect,[System.Drawing.Color]::FromArgb(10,14,23),[System.Drawing.Color]::FromArgb(72,26,34),[float]18)
   $cb=New-Object System.Drawing.Drawing2D.ColorBlend
   $cb.Positions=@([float]0,[float]0.28,[float]1)
   $cb.Colors=@([System.Drawing.Color]::FromArgb(255,10,14,23),[System.Drawing.Color]::FromArgb(255,10,14,23),[System.Drawing.Color]::FromArgb(255,72,26,34))
   $br.InterpolationColors=$cb
   $g.FillPath($br,$rr); $br.Dispose()
  } elseif($style -eq "glow"){
   # card: #0a0e17 + radial-gradient(circle at 50% 0%, srgb(53,96,215 / .08), #0a0e17)
   $g.FillPath((New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(255,10,14,23))),$rr)
   $gp=New-Object System.Drawing.Drawing2D.GraphicsPath
   $rad=[int]($ww*0.62); $gp.AddEllipse([int]($ww/2-$rad),[int](-$rad*0.55),$rad*2,$rad*2)
   $pg=New-Object System.Drawing.Drawing2D.PathGradientBrush($gp)
   $pg.CenterColor=[System.Drawing.Color]::FromArgb(20,53,96,215)
   $pg.SurroundColors=@([System.Drawing.Color]::FromArgb(0,53,96,215))
   $g.FillRectangle($pg,(New-Object System.Drawing.Rectangle(0,0,$ww,$hh))); $pg.Dispose(); $gp.Dispose()
  } else {
   # card: linear-gradient(155deg, srgb(8,13,24), #080b11 75%)
   $cardRect=New-Object System.Drawing.Rectangle(0,0,$ww,$hh)
   $br=New-Object System.Drawing.Drawing2D.LinearGradientBrush($cardRect,[System.Drawing.Color]::FromArgb(8,13,24),[System.Drawing.Color]::FromArgb(8,11,17),[float]65)
   $g.FillPath($br,$rr); $br.Dispose()
  }
  # sheen interno: linear-gradient(transparent 35%, rgba(255,255,255,.024))
  $sy=[int]($hh*0.35); if($hh-$sy -gt 0){
   $sr=New-Object System.Drawing.Rectangle(0,$sy,$ww,$hh-$sy)
   $sb=New-Object System.Drawing.Drawing2D.LinearGradientBrush($sr,[System.Drawing.Color]::FromArgb(0,255,255,255),[System.Drawing.Color]::FromArgb(6,255,255,255),[System.Drawing.Drawing2D.LinearGradientMode]::Vertical)
   $g.FillPath($sb,$rr); $sb.Dispose()
  }
  $g.DrawPath((New-Object System.Drawing.Pen([System.Drawing.Color]::FromArgb(255,41,44,52),1.2)),$rr)
  # bottom border highlight: rgb(190,204,242 / .16)
  $g.DrawLine((New-Object System.Drawing.Pen([System.Drawing.Color]::FromArgb(255,37,44,53),1)),1,($hh-1),($ww-1),($hh-1))
  $rr.Dispose()
 })
 return $p
}
