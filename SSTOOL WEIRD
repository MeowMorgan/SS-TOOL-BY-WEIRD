  GraphicsPath p=new GraphicsPath(); int rad=12,w=Width,h=Height;
  p.AddArc(0,0,rad,rad,180,90); p.AddArc(w-rad,0,rad,rad,270,90); p.AddArc(w-rad,h-rad,rad,rad,0,90); p.AddArc(0,h-rad,rad,rad,90,90); p.CloseFigure();
