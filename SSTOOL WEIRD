$form.Add_Shown({ Make-Rounded $form 16 })
Write-Log "SHARD.RIP Ocean-style ready"
Write-Log ("Install location: " + $workDir)
Write-Log ("Discord: " + $discordInvite)
[void]$form.ShowDialog()
