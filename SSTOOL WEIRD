  using(StringFormat sf=new StringFormat(){Alignment=StringAlignment.Center,LineAlignment=StringAlignment.Center})
  using(SolidBrush tb=new SolidBrush(Color.FromArgb(255,255,255))){ g.DrawString(Text,Font,tb,new Rectangle(0,0,w,h),sf); }
  p.Dispose();
 }
